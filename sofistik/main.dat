$ +++++++++++++++++++++++++++++++++++++++++++++++++++++++++
!+!chapter  Material und Querschnitte
$ +++++++++++++++++++++++++++++++++++++++++++++++++++++++++

+prog aqua urs:1
kopf

$ --------------------------------------
!*!label    Norm und Material
$ --------------------------------------

norm DIN EN199X-200X-BRIDGE
stah nr 1 art s guet 355


$ --------------------------------------
!*!label    Bleche
$ --------------------------------------

$ Seitenbleche

sto#mat_1 1
sto#grp_1 1
sto#t_1 30[mm]

$ Obere Bleche, Feldbereiche

sto#mat_2 1
sto#grp_2 2
sto#t_2 40[mm]

$ Obere Bleche, Stützbereiche

sto#mat_3 1
sto#grp_3 3
sto#t_3 30[mm]

$ Untere Bleche, Feldbereiche

sto#mat_4 1
sto#grp_4 4
sto#t_4 40[mm]

$ Untere Bleche, Stützbereiche

sto#mat_5 1
sto#grp_5 5
sto#t_5 30[mm]

$ Hauptsteifen

sto#mat_6 1
sto#grp_6 6
sto#t_6 20[mm]

$ Zwischensteifen

sto#mat_7 1
sto#grp_7 7
sto#t_7 20[mm]


$ --------------------------------------
!*!label    Auflagerbedingungen
$ --------------------------------------

sto#bc_1 "PXPZ"
sto#bc_2 "PXPZ"
sto#bc_3 "PP"

ende



$ +++++++++++++++++++++++++++++++++++++++++++++++++++++++++
!+!chapter  Geometrie
$ +++++++++++++++++++++++++++++++++++++++++++++++++++++++++

+prog sofimshc urs:2
kopf

echo voll voll

syst art 3d gdir negz gdiv 10000

steu mesh 2
steu hmin 1.0

#include ".\input\geometry.dat"

ende



$ +++++++++++++++++++++++++++++++++++++++++++++++++++++++++
!+!chapter  Lasten
$ +++++++++++++++++++++++++++++++++++++++++++++++++++++++++

+prog sofiload urs:3
kopf

#include ".\input\loads.dat"

lf nr 1 fakg 1

ende



$ +++++++++++++++++++++++++++++++++++++++++++++++++++++++++
!+!chapter  Berechnung
$ +++++++++++++++++++++++++++++++++++++++++++++++++++++++++

+prog ase urs:4
kopf

lf nr 1

ende



